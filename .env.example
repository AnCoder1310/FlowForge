# ==============================================================================
# FlowForge(DWOP) - Environment Variables
# ==============================================================================

# System Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security & Authentication (HMAC-SHA256 Token Signing)
AUTHENTICATION__SIGNINGKEY=development-only-workflow-orchestrator-signing-key-123456
TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Docker Compose PostgreSQL)
POSTGRES_DB=workflow_orchestrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

DATABASE_URL=postgresql://postgres:postgres@localhost:55432/workflow_orchestrator

# Local SQLite Database (Used by default in development)
SQLITE_DB_PATH=src/database/workflow_orchestrator.db

# AI Assistant & Self-Healing Engine (9Router / OpenAI / Antigravity Gateway)
AI_ENABLED=true
AI_PROVIDER=router
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_KEY=your-9router-or-gateway-api-key
AI_MODEL=gemini-3.8-flash-low
AI_TIMEOUT=60.0
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
